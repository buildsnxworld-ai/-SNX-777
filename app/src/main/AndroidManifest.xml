<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Queries for cross-app IPC and ContentProvider visibility on Android 11+ -->
    <queries>
        <package android:name="com.aistudio.snx777.website" />
        <package android:name="com.aistudio.snx777.admin" />
        <package android:name="com.aistudio.snx777.signal" />
        <intent>
            <action android:name="com.aistudio.snx777.ACTION_DATA_SYNC" />
        </intent>
        <provider android:authorities="com.aistudio.snx777.website.provider" />
        <provider android:authorities="com.aistudio.snx777.admin.provider" />
        <provider android:authorities="com.aistudio.snx777.signal.provider" />
    </queries>

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MyApplication">

        <!-- 1) Website App Entry Point (SNX 777) -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_casino"
            android:roundIcon="@mipmap/ic_launcher_casino"
            android:label="@string/user_app_name"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.MyApplication">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- 2) Admin Panel App Entry Point (SNX Admin) -->
        <activity
            android:name=".admin.AdminMainActivity"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_admin"
            android:roundIcon="@mipmap/ic_launcher_admin"
            android:label="@string/admin_app_name"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.MyApplication">
        </activity>

        <!-- 3) Signal App Entry Point (SNX Signal) -->
        <activity
            android:name=".signal.SignalMainActivity"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_signal"
            android:roundIcon="@mipmap/ic_launcher_signal"
            android:label="@string/signal_app_name"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.MyApplication">
        </activity>

        <!-- Real-time Cross-App IPC and Data Sync Provider -->
        <provider
            android:name=".data.SnxSyncProvider"
            android:authorities="${applicationId}.provider"
            android:exported="true" />

        <!-- Broadcast receiver for instant real-time synchronization between apps -->
        <receiver
            android:name=".data.SnxDataSyncReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="com.aistudio.snx777.ACTION_DATA_SYNC" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
